# The legacy.js/legacy.css bundles are generated by concatenating
# legacy-snapshot/ files in verified load order (scripts/build-legacy-bundles.mjs).
# Keep them byte-stable too, for the same reason as legacy-snapshot/.gitattributes -
# a rollback/diff artifact should not be silently rewritten by checkout-time
# line-ending normalization.
efb-form-builder.legacy.js -text -eol
efb-form-builder.legacy.css -text -eol
