#  origin: claude (de_DE) F13
#. translators: F13: link to WordPress' Settings > Privacy > Policy guide
#: includes/functions.php
msgid "Privacy policy guide"
msgstr "Leitfaden für die Datenschutzerklärung"

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text
#: includes/functions.php
msgid "When you submit a form on this site, the answers you enter are sent to us together with the form."
msgstr "Wenn du auf dieser Website ein Formular absendest, werden die eingegebenen Antworten zusammen mit dem Formular an uns übermittelt."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text
#: includes/functions.php
msgid "We store the answers, the files you upload and the replies exchanged about them, unless a form says that its entries are not stored."
msgstr "Wir speichern die Antworten, die von dir hochgeladenen Dateien und die dazu ausgetauschten Antworten, es sei denn, ein Formular gibt an, dass seine Einträge nicht gespeichert werden."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text, when IP addresses are stored
#: includes/functions.php
msgid "We also store your IP address and the type of your browser."
msgstr "Außerdem speichern wir deine IP-Adresse und die Art deines Browsers."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text, when IP addresses are anonymized
#: includes/functions.php
msgid "We store your IP address only in anonymized form (its last part removed), and the type of your browser."
msgstr "Wir speichern deine IP-Adresse nur anonymisiert (ohne ihren letzten Teil) sowie die Art deines Browsers."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text, when IP addresses are not stored
#: includes/functions.php
msgid "We do not store your IP address or your browser."
msgstr "Wir speichern weder deine IP-Adresse noch deinen Browser."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text. %s: number of days
#: includes/functions.php
#, php-format
msgid "Entries are deleted automatically %s days after their last activity."
msgstr "Einträge werden %s Tage nach ihrer letzten Aktivität automatisch gelöscht."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text, when there is no automatic deletion
#: includes/functions.php
msgid "Entries are kept until a site administrator deletes them."
msgstr "Einträge werden aufbewahrt, bis ein Administrator der Website sie löscht."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text. %s: list of services such as Telegram or Google Sheets
#: includes/functions.php
#, php-format
msgid "Notifications about your submission are sent by email, and may also be sent to: %s."
msgstr "Benachrichtigungen über deine Übermittlung werden per E-Mail versendet und können außerdem gesendet werden an: %s."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text, when reCAPTCHA is configured
#: includes/functions.php
msgid "Some forms use Google reCAPTCHA to tell people from automated programs; Google's privacy policy applies to it."
msgstr "Einige Formulare verwenden Google reCAPTCHA, um Menschen von automatisierten Programmen zu unterscheiden; dafür gilt die Datenschutzerklärung von Google."

#  origin: claude (de_DE) F13
#. translators: F13: suggested privacy policy text about the visitor's rights
#: includes/functions.php
msgid "You can ask for a copy of the personal data your entries contain, or for its deletion, through this site's privacy request."
msgstr "Über die Datenschutzanfrage dieser Website kannst du eine Kopie der personenbezogenen Daten in deinen Einträgen oder deren Löschung anfordern."
